# You.com — Search + Contents (grounding). https://you.com/platform/api-keys
YDC_API_KEY=

# Parasail — OpenAI-compatible inference + embeddings. https://www.saas.parasail.io/keys
PARASAIL_API_KEY=
PARASAIL_MODEL=parasail-qwen3-235b-a22b-instruct-2507
PARASAIL_EMBED_MODEL=parasail-bge-m3
PARASAIL_RPM=60              # client-side throttle; free keys are 5 RPM, paid 500

# One (withone.ai) — real actions in Slack and GitHub. `npx -y @withone/mcp` reads ONE_SECRET.
ONE_SECRET=
ONE_CONNECTION_KEYS=         # optional: comma-separated connection keys for slack,github (from `exorcist smoke`)
SLACK_CHANNEL=#loft-incident
GITHUB_REPO=owner/repo

# Runtime
EXORCIST_CONCURRENCY=2       # investigation crews running at once
EXORCIST_PORT=8000
